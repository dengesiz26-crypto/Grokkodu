# Required for live bulletin, odds, lineups, results. Store as GitHub secret GOALDIR_API_KEY.
GOALDIR_API_KEY=
# Alias accepted:
# GOAL_API_KEY=

# Optional fallbacks
API_FOOTBALL_KEY=
ODDS_API_IO_KEY=

GOALDIR_BASE_URL=https://api.goal-api.com/v1
DATABASE_PATH=data/football.db
MODEL_DIR=data/models
EXECUTION_MODE=paper
ENABLE_LIVE_EXECUTION=false
MIN_EDGE=0.04
MIN_PROB=0.46
MAX_ODDS=3.8
MIN_ODDS=1.38
CAPTURE_TODAY_AND_TOMORROW=true
LINEUP_HORIZON_HOURS=8
LINEUP_MAX_PER_RUN=18
